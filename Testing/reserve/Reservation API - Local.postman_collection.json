{
  "info": {
    "_postman_id": "b271b6b0-75da-413b-9d9a-6bbd0398557b",
    "name": "Reservation API - Local",
    "description": "End-to-end local flow: create a show, read it, reserve a seat, replay the idempotent request, cancel, and verify the seat is released. Run requests in order. Update adminToken if APP_ADMIN_TOKEN is set to a different value in Spring Boot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "18685238"
  },
  "item": [
    {
      "name": "1. Create show",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('runId', Date.now().toString());"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('show created', function () {",
              "    pm.response.to.have.status(201);",
              "    const show = pm.response.json();",
              "    pm.expect(show.id).to.be.a('string');",
              "    pm.collectionVariables.set('showId', show.id);",
              "    pm.collectionVariables.set('idempotencyKey', 'postman-' + pm.collectionVariables.get('runId'));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_secret_1do2}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Postman test show 2\",\n    \"seats\": [\n        \"A1\",\n        \"A2\",\n        \"B1\",\n        \"B2\"\n    ],\n    \"price_paise\": 25000,\n    \"per_user_limit\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/create/show",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "create",
            "show"
          ]
        },
        "description": "Creates a fresh show and saves its ID for the following requests."
      },
      "response": []
    },
    {
      "name": "2. Get show",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('show can be fetched', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('showId'));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_secret_1do2}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/show/f92c7cc9-c126-4095-ba7f-67309db53988",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "show",
            "f92c7cc9-c126-4095-ba7f-67309db53988"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get All Show",
      "request": {
