            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/shows",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "shows"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Reserve seat",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('reservation created', function () {",
              "    pm.response.to.have.status(201);",
              "    const reservation = pm.response.json();",
              "    pm.expect(reservation.status).to.eql('confirmed');",
              "    pm.collectionVariables.set('reservationId', reservation.id);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "2",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "3"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seats\": [\"A1\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/shows/reserve/e8dd9aad-73a7-4c92-8b6d-524304618add",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "shows",
            "reserve",
            "e8dd9aad-73a7-4c92-8b6d-524304618add"
          ]
        },
        "description": "Books A1 using both the optional header key and body fallback key."
      },
      "response": []
    },
