{
  "info": {
    "name": "Reservation API - Local",
    "description": "End-to-end local flow: create a show, read it, reserve a seat, replay the idempotent request, cancel, and verify the seat is released. Run requests in order. Update adminToken if APP_ADMIN_TOKEN is set to a different value in Spring Boot.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "local-dev-admin-token",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "postman-test-user",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "showId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create show",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('show created', function () {",
              "    pm.response.to.have.status(201);",
              "    const show = pm.response.json();",
              "    pm.expect(show.id).to.be.a('string');",
              "    pm.collectionVariables.set('showId', show.id);",
              "    pm.collectionVariables.set('idempotencyKey', 'postman-' + pm.collectionVariables.get('runId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman test show {{runId}}\",\n  \"seats\": [\"A1\", \"A2\", \"B1\"],\n  \"price_paise\": 25000,\n  \"per_user_limit\": 4\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/shows",
        "description": "Creates a fresh show and saves its ID for the following requests."
      },
      "response": []
    },
    {
      "name": "2. Get show",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('show can be fetched', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('showId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/shows/{{showId}}"
      },
      "response": []
    },
    {
      "name": "3. Reserve seat",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('reservation created', function () {",
              "    pm.response.to.have.status(201);",
              "    const reservation = pm.response.json();",
              "    pm.expect(reservation.status).to.eql('booked');",
              "    pm.collectionVariables.set('reservationId', reservation.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotency_key\": \"{{idempotencyKey}}\",\n  \"seats\": [\"A1\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/shows/{{showId}}/reserve",
        "description": "Books A1 using both the optional header key and body fallback key."
      },
      "response": []
    },
    {
      "name": "4. Replay reservation (idempotency)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('same request replays successfully', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('reservationId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotency_key\": \"{{idempotencyKey}}\",\n  \"seats\": [\"A1\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/shows/{{showId}}/reserve"
      },
      "response": []
    },
    {
      "name": "5. Cancel reservation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('reservation cancelled', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('cancelled');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/reservations/cancel/{{reservationId}}"
      },
      "response": []
    },
    {
      "name": "6. Verify seat released",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('cancelled seat is available again', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().seats.A1).to.eql('available');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/shows/{{showId}}"
      },
      "response": []
    }
  ]
}
